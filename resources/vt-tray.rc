#include <winver.h>

1 ICON "vt-tray.ico"
1 24 "app.manifest"

// Windows shows these as the app's name and publisher (Task Manager, Startup apps,
// notification settings, file properties). Keep the version in step with Cargo.toml.
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "abusayed.dev"
            VALUE "FileDescription",  "VT Tray"
            VALUE "FileVersion",      "1.0.0"
            VALUE "InternalName",     "VTray"
            VALUE "LegalCopyright",   "Copyright (c) 2026 abusayed.dev"
            VALUE "OriginalFilename", "VTray.exe"
            VALUE "ProductName",      "VT Tray"
            VALUE "ProductVersion",   "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
